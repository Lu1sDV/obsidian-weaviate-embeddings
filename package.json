    "esbuild": "^0.25.0",
    "obsidian": "^1.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "ignore": "7.0.5"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.4"
  }
}
