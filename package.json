{
  "name": "obsidian-local-semantic-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs production",
    "dev": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
